{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diyuai.cc/schemas/execution-control-v1.schema.json",
  "title": "TENANT-01 execution control state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state_version",
    "milestone",
    "current_state",
    "previous_state",
    "objective_digest",
    "contract_digest",
    "controller_decision_digest",
    "head_sha",
    "origin_sha",
    "worktree_digest",
    "protected_user_change_digest",
    "active_gate",
    "completed_gates",
    "active_run_id",
    "active_command",
    "active_pid",
    "started_at",
    "heartbeat_at",
    "last_completed_at",
    "failure_class",
    "failure_count_by_class",
    "governance_version",
    "acceptance_runs",
    "evidence_paths",
    "approved_next_action",
    "executor_id",
    "event_count",
    "last_event_hash"
  ],
  "properties": {
    "state_version": {"const": "TENANT-01-EXECUTION-CONTROL-V1"},
    "milestone": {"const": "TENANT-01"},
    "current_state": {"type": "string"},
    "previous_state": {"type": ["string", "null"]},
    "objective_digest": {"$ref": "#/$defs/sha256"},
    "contract_digest": {"$ref": "#/$defs/sha256"},
    "controller_decision_digest": {"$ref": "#/$defs/sha256"},
    "head_sha": {"$ref": "#/$defs/gitSha"},
    "origin_sha": {"$ref": "#/$defs/gitSha"},
    "worktree_digest": {"$ref": "#/$defs/sha256"},
    "protected_user_change_digest": {"$ref": "#/$defs/sha256"},
    "active_gate": {"type": ["string", "null"]},
    "completed_gates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "active_run_id": {"type": ["string", "null"]},
    "active_command": {"type": ["string", "null"]},
    "active_pid": {"type": ["integer", "null"], "minimum": 1},
    "started_at": {"type": "string"},
    "heartbeat_at": {"type": "string"},
    "last_completed_at": {"type": ["string", "null"]},
    "failure_class": {"type": ["string", "null"]},
    "failure_count_by_class": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "governance_version": {"type": "string", "minLength": 1},
    "acceptance_runs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "candidate_sha",
          "suite_id",
          "acceptance_run_id",
          "config_digest",
          "status",
          "started_at",
          "completed_at",
          "samples",
          "failure_count_by_class"
        ]
      }
    },
    "evidence_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "approved_next_action": {"type": ["string", "null"]},
    "executor_id": {"type": "string", "minLength": 1},
    "event_count": {"type": "integer", "minimum": 1},
    "last_event_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  }
}
